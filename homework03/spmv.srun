#!/bin/bash
#SBATCH --account=smearlab              ### your ‘charge’ account
#SBATCH --partition=compute             ### queue to submit to
#SBATCH --job-name=spmv                 ### job name
#SBATCH --output=output/spmv_%A.out     ### file in which to store job stdout
#SBATCH --error=output/spmv_%A.err      ### file in which to store job stderr
#SBATCH --time=00:30:00                 ### wall-clock time limit, in minutes
#SBATCH --mem=16000M                    ### memory limit per node (K|M|G|T)
#SBATCH --nodes=1                       ### number of nodes to use
#SBATCH --ntasks-per-node=1             ### number of MPI tasks per node
#SBATCH --cpus-per-task=64              ### number of CPUs for each task

export OMP_PLACES="cores"
export OMP_PROC_BIND='spread'

make

# 20 runs at each thread count, never more threads than cpus-per-task.
# just runs the readme example text
for t in 2 4 8 16 32 64; do
    export OMP_NUM_THREADS=$t
    for run in $(seq 20); do
        echo "threads=$t run=$run"
        ans=output/myans_t${t}_r${run}.mtx
        ./spmv cant/cant.mtx cant/b.mtx "$ans"
        if diff -q "$ans" cant/ans.mtx > /dev/null; then
            echo "check: MATCH"
        else
            echo "check: DIFFERS from cant/ans.mtx"
        fi
    done
done
