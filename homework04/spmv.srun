#!/bin/bash
#SBATCH --account=smearlab
#SBATCH --job-name=spmv_gpu   ### Job Name
#SBATCH --output=spmv_%j.out  ### File in which to store job output
#SBATCH --error=spmv_%j.err   ### File in which to store job error messages
#SBATCH --partition=gpu       ### Quality of Service (like a queue in PBS)
#SBATCH --time=1-00:00:00     ### Wall clock time limit in Days-HH:MM:SS
#SBATCH --nodes=1             ### Node count required for the job
#SBATCH --ntasks-per-node=1   ### Nuber of tasks to be launched per Node
#SBATCH --gres=gpu:nvidia_a100_80gb_pcie:1
#SBATCH --cpus-per-task=28     ### Number of threads per task (OMP threads)

# cuda/10.2 and gcc/7.3 (from the README) no longer exist on Talapas.
# The Makefile builds with the system g++ 8.5.0 and links CUDA 11.2's runtime,
# which has no module, so point the loader at its libraries directly.
module --ignore_cache load "gcc/8.5.0"
export LD_LIBRARY_PATH=/packages/cuda/11.2.0/lib64${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}

export OMP_PROC_BIND=true
export OMP_NUM_THREADS=28

./spmv cant/cant.mtx cant/b.mtx ./test.mtx 
